#!/usr/bin/env bash
set -euo pipefail

# Karakeep — Tester Environment CLI
# Usage: ./tester-env <command> [--run-id <id>] [--port <port>]
# Commands: deploy, seed, verify, reset, stop, logs, status, help

RUN_ID="default"
PORT="3010"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="${SCRIPT_DIR}/docker-compose.tester-env.yml"
export PORT
ADMIN_EMAIL="${ADMIN_EMAIL:-admin@karakeep.local}"
ADMIN_PASSWORD="${ADMIN_PASSWORD:-admin12345}"

refresh_names() {
    local suffix=""
    if [[ "${RUN_ID}" != "default" ]]; then
        suffix="-${RUN_ID}"
    fi
    COMPOSE_PROJECT="karakeep${suffix}"
}

compose() { docker compose -f "$COMPOSE_FILE" --project-name "$COMPOSE_PROJECT" "$@"; }

wait_health() {
    # 300s budget: cold compiles plus possible crash-restart cycles on flaky node bases.
    for _ in $(seq 1 60); do
        curl -sf "http://localhost:${PORT}/api/health" >/dev/null 2>&1 && return 0
        sleep 5
    done
    echo "Karakeep not healthy after 300s" >&2
    return 1
}

# Run a command, retrying only on native crash exit codes (134/139).
# better-sqlite3 under node 24.20 aborts flakily mid-run or at teardown;
# the seed/verify scripts are idempotent, so a retry is always safe.
retry_on_crash() {
    local label="$1"; shift
    local attempt=1
    while true; do
        set +e
        "$@"
        local rc=$?
        set -e
        if [ "$rc" -eq 0 ]; then
            return 0
        fi
        case "$rc" in
            134|139)
                if [ "$attempt" -ge 3 ]; then
                    echo "==> ${label}: native crash (exit ${rc}) after ${attempt} attempts" >&2
                    return "$rc"
                fi
                echo "==> ${label}: native crash (exit ${rc}), retry ${attempt}/3" >&2
                attempt=$((attempt+1))
                ;;
            *)
                return "$rc"
                ;;
        esac
    done
}

cmd_deploy() {
    echo "==> Building base image (docker/Dockerfile.tester-env, pinned node base)..."
    docker build -f "${SCRIPT_DIR}/docker/Dockerfile.tester-env" -t karakeep-web-dev:latest "${SCRIPT_DIR}"

    echo "==> Starting meilisearch and running prep..."
    compose up -d meilisearch
    compose run --rm prep

    echo "==> Starting web service..."
    compose up -d web

    wait_health

    echo "==> Creating admin user (idempotent)..."
    curl -sf -X POST "http://localhost:${PORT}/api/trpc/users.create" \
        -H 'Content-Type: application/json' \
        -d "{\"json\":{\"name\":\"Admin\",\"email\":\"${ADMIN_EMAIL}\",\"password\":\"${ADMIN_PASSWORD}\",\"confirmPassword\":\"${ADMIN_PASSWORD}\"}}" \
        >/dev/null 2>&1 || true

    echo "==> Karakeep ready at http://localhost:${PORT}"
    echo "==> Credentials: ${ADMIN_EMAIL} / ${ADMIN_PASSWORD}"
}

cmd_seed() {
    wait_health
    echo "==> Seeding deterministic data..."
    retry_on_crash seed compose exec -T web node /app/tester-env-seed.cjs
    echo "==> Seed complete."
}

cmd_verify() {
    wait_health
    echo "==> Verifying seeded state..."
    retry_on_crash verify compose exec -T web node /app/tester-env-verify.cjs
    echo "==> Verification passed."
}

cmd_reset() {
    echo "==> Stopping and removing containers/volumes..."
    compose down -v 2>/dev/null || true
    echo "==> Reset complete."
}

cmd_stop() {
    compose stop 2>/dev/null || true
    echo "==> Stopped."
}

cmd_logs() {
    compose logs -f
}

cmd_status() {
    compose ps
}

cmd_help() {
    cat <<EOF
Karakeep — Tester Environment CLI

Usage: ./tester-env <command> [--run-id <id>] [--port <port>]

Commands:
  deploy    Build image, start services, migrate DB, create admin user
  seed      Populate with deterministic seed data
  verify    Assert seeded state is intact
  reset     Stop and remove containers + volumes
  stop      Stop containers (preserves data)
  logs      Tail container logs
  status    Show container status
  help      Show this help

Options:
  --run-id <id>     Isolate compose project for parallel runs (default: default)
  --port <port>     Host port (default: 3010)

Credentials: admin@karakeep.local / admin12345
URL: http://localhost:3010
EOF
}

main() {
    local cmd="${1:-help}"
    shift 2>/dev/null || true

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --run-id) RUN_ID="$2"; shift 2;;
            --port) PORT="$2"; shift 2;;
            *) echo "Unknown option: $1" >&2; exit 1;;
        esac
    done

    refresh_names

    case "$cmd" in
        deploy)     cmd_deploy;;
        seed)       cmd_seed;;
        verify)     cmd_verify;;
        reset)      cmd_reset;;
        stop)       cmd_stop;;
        logs)       cmd_logs;;
        status)     cmd_status;;
        help|--help|-h) cmd_help;;
        *)          echo "Unknown command: $cmd" >&2; cmd_help; exit 1;;
    esac
}

main "$@"
