# Tester-env pinned base for the karakeep fork.
#
# Node 24 is unstable for this app on this host. The qualification-2 run on
# node:24.19-alpine logged 6 native "Assertion failed: (env) != nullptr" aborts
# between 05:53 and 06:44 with RestartCount 3 (better-sqlite3 / Next.js dev
# cold compiles), and the moving node:24-alpine tag aborted on v24.20.0. Pin
# Node 22 LTS (v22.23.3) at an immutable official manifest digest; a cold
# pnpm install rebuilds better-sqlite3 against the Node 22 ABI automatically.
FROM node:22.23.3-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402

WORKDIR /app
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# Check https://github.com/nodejs/docker-node/tree/b4117f9333da4138b03a546ec926ef50a31506c3#nodealpine to understand why libc6-compat might be needed.
RUN apk add --no-cache libc6-compat make g++ py3-pip linux-headers git

RUN corepack enable

COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
