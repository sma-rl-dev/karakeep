# Tester-env pinned base for the karakeep fork.
#
# Same as docker/Dockerfile.dev but with the node base pinned instead of the
# moving node:24-alpine tag. The moving tag moved to node v24.20.0 on
# 2026-09-02 and node processes in that image abort/segfault nondeterministically
# (RemoveEnvironmentCleanupHook assertion / SIGSEGV) in better-sqlite3 and
# Next.js workloads, making deploys and the web server unstable. Pin the last
# known-good minor line until upstream node or better-sqlite3 resolves it.
FROM node:24.19-alpine

WORKDIR /app
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# Check https://github.com/nodejs/docker-node/tree/b4117f9333da4138b03a546ec926ef50a31506c3#nodealpine to understand why libc6-compat might be needed.
RUN apk add --no-cache libc6-compat make g++ py3-pip linux-headers git

RUN corepack enable

COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
